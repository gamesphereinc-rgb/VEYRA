#define AppName "VEYRA"
#define AppVersion "@PROJECT_VERSION@"
#define BuildDirectory "@VEYRA_BUILD_DIRECTORY@"
#define IconPath "@VEYRA_ICON_PATH@"
#define LicensePath "@VEYRA_LICENSE_PATH@"
#define InstallerOutputDirectory "@VEYRA_INSTALLER_DIRECTORY@"

[Setup]
AppId={{D4B8A41C-8E19-48B6-AE2A-8B102B6A1A4E}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=VEYRA
AppPublisherURL=https://github.com/gamesphereinc-rgb/VEYRA
AppSupportURL=https://github.com/gamesphereinc-rgb/VEYRA/issues
DefaultDirName={localappdata}\Programs\VEYRA
DefaultGroupName=VEYRA
DisableProgramGroupPage=yes
UninstallDisplayName=VEYRA
UninstallDisplayIcon={app}\VEYRA.exe
SetupIconFile={#IconPath}
LicenseFile={#LicensePath}
OutputDir={#InstallerOutputDirectory}
OutputBaseFilename=VEYRA-Setup-{#AppVersion}-x64
ArchitecturesAllowed=x64
ArchitecturesInstallIn64BitMode=x64
PrivilegesRequired=lowest
CloseApplications=yes
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
VersionInfoCompany=VEYRA
VersionInfoDescription=VEYRA browser setup
VersionInfoProductName=VEYRA
VersionInfoProductVersion={#AppVersion}
VersionInfoVersion={#AppVersion}
SetupLogging=yes

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Additional shortcuts:"; Flags: unchecked

[Files]
Source: "{#BuildDirectory}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\VEYRA"; Filename: "{app}\VEYRA.exe"; WorkingDir: "{app}"
Name: "{autoprograms}\Uninstall VEYRA"; Filename: "{uninstallexe}"
Name: "{autodesktop}\VEYRA"; Filename: "{app}\VEYRA.exe"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\VEYRA.exe"; Description: "Launch VEYRA"; WorkingDir: "{app}"; Flags: nowait postinstall skipifsilent
